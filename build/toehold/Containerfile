FROM registry.access.redhat.com/ubi9/go-toolset:1.25.9-1778604137 AS builder
USER 0
WORKDIR /build
COPY . .
ENV GOFLAGS="-mod=vendor"
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-w -s" -o /toehold-uploader ./cmd/toehold-uploader

FROM registry.access.redhat.com/ubi9-minimal:9.7-1778562320
COPY --from=builder /toehold-uploader /usr/local/bin/toehold-uploader
ENTRYPOINT ["/usr/local/bin/toehold-uploader"]
