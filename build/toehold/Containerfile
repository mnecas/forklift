FROM registry.access.redhat.com/ubi9/go-toolset:1.25.9-1778604137 AS builder
USER 0
WORKDIR /build
COPY . .
ENV GOFLAGS="-mod=vendor"
RUN CGO_ENABLED=0 GOOS=linux go build -buildvcs=false -ldflags="-w -s" -o /toehold-importer ./cmd/toehold-importer \
    && curl -fsSL -o /tmp/govc.tgz https://github.com/vmware/govmomi/releases/download/v0.52.0/govc_Linux_x86_64.tar.gz \
    && tar -C /usr/local/bin -xzf /tmp/govc.tgz govc \
    && rm -f /tmp/govc.tgz

FROM registry.access.redhat.com/ubi9-minimal:9.7-1778562320
COPY --from=builder /toehold-importer /usr/local/bin/toehold-importer
COPY --from=builder /usr/local/bin/govc /usr/local/bin/govc
ENTRYPOINT ["/usr/local/bin/toehold-importer"]
