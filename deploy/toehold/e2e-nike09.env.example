# Copy to e2e-nike09.env (gitignored) and fill in values.
#   cp deploy/toehold/e2e-nike09.env.example deploy/toehold/e2e-nike09.env

# OpenShift API (add /etc/hosts entry: 10.37.160.79 api.nike09.mtv.local)
OCP_API_URL=https://api.nike09.mtv.local:6443
OCP_USER=kubeadmin
OCP_PASSWORD=

# vCenter 8.0.3 — only needed when creating/updating the Provider secret manually
VCENTER_URL=https://10.37.160.51/sdk
VCENTER_USER=administrator@vsphere.local
VCENTER_PASSWORD=

# MTV namespace and existing provider name on nike09
MTV_NAMESPACE=openshift-mtv
PROVIDER_NAME=vsphere

# Toehold target namespace (created by hack/toehold-e2e-nike09.sh)
TOEHOLD_TARGET_NS=toehold-e2e

# Custom images built from feature/toehold-controller branch
REGISTRY=quay.io
REGISTRY_ORG=mnecas0
REGISTRY_TAG=toehold-dev
CONTROLLER_IMAGE=${REGISTRY}/${REGISTRY_ORG}/forklift-controller:${REGISTRY_TAG}
TOEHOLD_UPLOADER_IMAGE=${REGISTRY}/${REGISTRY_ORG}/toehold-uploader:${REGISTRY_TAG}

# vSphere inventory — verify against your datacenter before applying e2e-nike09.yaml
VCENTER_DATASTORE=datastore1
VCENTER_FOLDER=/Datacenter/vm
VCENTER_NETWORK=VM Network
